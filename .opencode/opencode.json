{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute Local",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "coding/free": {
          "name": "coding/free",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 16384,
            "input": 128000
          }
        },
        "reasoning/free": {
          "name": "reasoning/free",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 64000,
            "input": 131072
          }
        },
        "fast/free": {
          "name": "fast/free",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 16384,
            "input": 65536
          }
        }
      }
    }
  }
}
